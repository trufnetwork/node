#!/bin/bash
# -----------------------------------------------------------------------------
# ⚠ WARNING: This file is auto-generated from a template. Do not edit directly!
# -----------------------------------------------------------------------------
# Starts the gateway. The session secret is read from SSM Parameter Store on
# every start, so a new value only needs a restart. Keep tracing off here.
set +x
set -euo pipefail

PARAM_NAME="/tsn/test/kgw/session_secret"
AWS_REGION="us-west-2"

SESSION_SECRET=""
for attempt in 1 2 3 4 5; do
  if SESSION_SECRET="$(aws ssm get-parameter --name "$PARAM_NAME" --with-decryption \
      --query Parameter.Value --output text --region "$AWS_REGION")"; then
    break
  fi
  echo "Reading SSM parameter $PARAM_NAME failed (attempt $attempt/5)" >&2
  if [ "$attempt" -lt 5 ]; then sleep 5; fi
done
if [ -z "$SESSION_SECRET" ]; then
  echo "ERROR: session secret parameter $PARAM_NAME is missing or empty; the gateway will not start." >&2
  exit 1
fi
export SESSION_SECRET

docker compose -p "kgw" -f "/home/ec2-user/kgw/gateway-compose.yaml" up -d --wait || true
