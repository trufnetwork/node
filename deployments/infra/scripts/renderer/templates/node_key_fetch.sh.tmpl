{{- /*
Template: node_key_fetch.sh.tmpl
Description: Writes this node's nodekey.json from an SSM SecureString at first
             boot. The value goes only to the key file. Exits non-zero, so the
             node is never started, if the parameter cannot be read or is empty.
Expected variables:
  .Region        (string): AWS Region of the parameter.
  .ParameterName (string): SSM parameter holding the nodekey.json content.
  .KeyFilePath   (string): Path of the nodekey.json file kwild reads.
  .Owner         (string): User and group that own the key file.
*/ -}}
# -----------------------------------------------------------------------------
# ⚠ WARNING: This file is auto-generated from a template. Do not edit directly!
# -----------------------------------------------------------------------------
{{- /* Validate required input */ -}}
{{- if not .Region }}{{ fail "missing required field '.Region'" }}{{- end -}}
{{- if not .ParameterName }}{{ fail "missing required field '.ParameterName'" }}{{- end -}}
{{- if not .KeyFilePath }}{{ fail "missing required field '.KeyFilePath'" }}{{- end -}}
{{- if not .Owner }}{{ fail "missing required field '.Owner'" }}{{- end }}

# Node key: read from SSM Parameter Store and written only to the key file.
NODE_KEY_PARAM="{{ .ParameterName }}"
NODE_KEY_FILE="{{ .KeyFilePath }}"
node_key_umask="$(umask)"
umask 077
node_key_ok=false
for attempt in 1 2 3 4 5; do
  if aws ssm get-parameter --name "$NODE_KEY_PARAM" --with-decryption \
      --query Parameter.Value --output text --region "{{ .Region }}" > "$NODE_KEY_FILE"; then
    node_key_ok=true
    break
  fi
  echo "Reading SSM parameter $NODE_KEY_PARAM failed (attempt $attempt/5)" >&2
  if [ "$attempt" -lt 5 ]; then sleep 5; fi
done
umask "$node_key_umask"
if [ "$node_key_ok" != true ] || [ ! -s "$NODE_KEY_FILE" ]; then
  rm -f "$NODE_KEY_FILE"
  echo "ERROR: node key parameter $NODE_KEY_PARAM is missing or empty; the node will not start." >&2
  exit 1
fi
chown {{ .Owner }}:{{ .Owner }} "$NODE_KEY_FILE"
chmod 600 "$NODE_KEY_FILE"
