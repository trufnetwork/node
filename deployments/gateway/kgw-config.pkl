/*
  PKL docs: https://pkl-lang.org/main/current/language-tutorial/01_basic_config.html

  The intention of usage is outputting a JSON object with the configuration values
  while manipulating its values as simply as possible.

  There are some differences between CLI inputs for KGW and the configuration file format
  i.e. comma separated strings to list.

  In this way we expect to keep our docker image and docker compose files:
  - more flexible
  - not needing to rebuild for a config change

  Usage: pkl eval kgw-config.pkl
  // output will be a JSON object

  TODO: if KGW starts to support ENV variables, we can remove this setup
*/

// hard coded values
listen_addr = "0.0.0.0:8090"
statement = "I agree to the terms and conditions."

// env variable string values
domain = read?("env:DOMAIN")
session_secret = read?("env:SESSION_SECRET")
log_level = read?("env:LOG_LEVEL")
chain_id = read("env:CHAIN_ID")
tsl_cert_file = read?("env:TSL_CERT_FILE")
tsl_key_file = read?("env:TSL_KEY_FILE")
// default 30 seconds
read_timeout = read?("env:READ_TIMEOUT")?.toInt()

// env variable for trusting X-Forwarded-For headers
// default to null if not provided or not an integer
hidden xff_trust_proxy_count_raw = read?("env:XFF_TRUST_PROXY_COUNT")
xff_trust_proxy_count = xff_trust_proxy_count_raw?.toIntOrNull()

// env variable boolean values
allow_deploy_db = read?("env:ALLOW_DEPLOY_DB") == "true"
allow_adhoc_query = read?("env:ALLOW_ADHOC_QUERY") == "true"

// cookie same site configuration
cookie_same_site = read?("env:COOKIE_SAME_SITE")

// SPECIAL CASE: BACKENDS
// we just need to split the string by comma
hidden backends_str = read("env:BACKENDS")
backends = backends_str.split(",")

// SPECIAL CASE: HANDLING CORS
// * is a special value that means all origins are allowed
// but in kgw config, it just means something that wasn't set, and not a list containing "*"
hidden cors_allow_origins_raw = read?("env:CORS_ALLOW_ORIGINS")
// if not provided, we return an empty list: otherwise we split by comma
cors_allow_origins = if (
  cors_allow_origins_raw == null
  || cors_allow_origins_raw.isEmpty
)
  null else
  cors_allow_origins_raw.split(",")

// SPECIAL CASE: ACTIONS EXEMPT FROM AUTHENTICATION
// Public views that take the market or the wallet as an argument and never read
// @caller, so a session adds nothing to them. Every other action keeps needing one:
// stream reads check @caller for private streams.
// A name a network does not have is ignored, so one list covers testnet and mainnet.
// AUTHN_EXEMPT_ACTIONS (comma separated, no spaces) replaces the list.
hidden default_authn_exempt_actions = List(
  // order books and markets
  "get_order_book",
  "get_market_depth",
  "get_full_market_depth",
  "get_best_prices",
  "get_market_info",
  "get_market_by_hash",
  "list_markets",
  "get_market_activity",
  // a wallet's positions, collateral, order events and balances
  "get_positions_by_wallet",
  "get_collateral_by_wallet",
  "get_order_events_by_wallet",
  "get_ordered_balances",
  // bridge balances: mainnet, then testnet
  "eth_truf_wallet_balance",
  "eth_usdc_wallet_balance",
  "hoodi_tt_wallet_balance",
  "hoodi_tt2_wallet_balance",
  "sepolia_wallet_balance",
  "ethereum_wallet_balance"
)
hidden authn_exempt_actions_raw = read?("env:AUTHN_EXEMPT_ACTIONS")
authn_exempt_actions = if (
  authn_exempt_actions_raw == null
  || authn_exempt_actions_raw.isEmpty
)
  default_authn_exempt_actions else
  authn_exempt_actions_raw.split(",")

// OpenTelemetry configurations
export_meta_log = read?("env:EXPORT_RPC_META_LOG") == "true"
meta_log_format = read?("env:META_LOG_FORMAT")
meta_log_output = read?("env:META_LOG_OUTPUT")
meta_log_otel_processor = read?("env:META_LOG_OTEL_PROCESSOR")
meta_log_otel_collector = read?("env:OTEL_EXPORTER_OTLP_ENDPOINT")
meta_log_otel_collector_tls = read?("env:META_LOG_OTEL_COLLECTOR_TLS") == "true"
meta_log_otel_collector_cert = read?("env:META_LOG_OTEL_COLLECTOR_CERT")

// Remove empty strings and null values from final file
hidden rendered = module.toMap().filter((_, val) -> val is Boolean || (val != null && if (val is String) val?.isEmpty != true else true))

output {
  // by specifying here, we don't need to specify in the pkl CLI usage
  renderer = new JsonRenderer {}
  value = rendered
}